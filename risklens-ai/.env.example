# ============================================
# RiskLens AI — Environment Configuration
# ============================================
# Copy this file to .env and fill in the values

# --- Application ---
APP_NAME=RiskLens AI
APP_ENV=development
APP_DEBUG=true
APP_VERSION=1.0.0
API_KEY=risklens-dev-key-2026

# --- FastAPI ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- MongoDB ---
MONGODB_URI=mongodb://risklens:risklens2026@localhost:27017/risklens?authSource=admin
MONGODB_DB_NAME=risklens

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=risklens-consumers

# --- Anthropic Claude API ---
ANTHROPIC_API_KEY=your-claude-api-key-here
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_MAX_TOKENS=1024
CLAUDE_TEMPERATURE=0.3

# --- LangSmith (Observability) ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langsmith-api-key-here
LANGCHAIN_PROJECT=risklens-ai

# --- Market Data ---
# Real Yahoo Finance polling interval (seconds) — used by market_data_worker
YAHOO_FINANCE_POLL_INTERVAL_SECONDS=60
# Synthetic mock poller interval (seconds) — used by mock_price_poller_worker (offline/demo mode)
MOCK_POLL_INTERVAL_SECONDS=30
# For MongoDB Atlas: mongodb+srv://user:password@cluster.mongodb.net/
# For local Docker:   mongodb://risklens:risklens2026@localhost:27017/risklens?authSource=admin

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=risklens-alerts@risklens.ai

# --- Jira ---
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=your-email@company.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=RISK

# --- Frontend ---
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
